# Valeurs non secrètes utilisées pour générer config.toml.
FREELLM_MODEL=qwen3.8-27b-lemon
FREELLM_BASE_URL=https://freellm.example.com/v1
CODEX_HOME_DIR=/home/your-user/.codex-freellm
MODEL_CATALOG_JSON=/home/your-user/.codex-freellm/models.json
CODEX_CLI_PATH=/home/your-user/.codex-cli-npm/lib/node_modules/@openai/codex/bin/codex.js
FREELLM_DESKTOP_RESOURCES=/home/your-user/.local/opt/codex-desktop-linux/codex-app-freellm/resources

# Secrets requis au runtime, jamais copiés dans config.toml ni dans Git.
# FREELLMAPI_API_KEY=replace-me
# CF_ACCESS_CLIENT_ID=replace-me
# CF_ACCESS_CLIENT_SECRET=replace-me
